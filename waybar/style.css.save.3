@import "colors/colors.css";

/* Borde de la barra completa */
* {
    background: transparent;   /* Fondo */
    color: #B988FF;        /* Texto/iconos */
    font-family: "JetBrainsMono Nerd Font";

    border: 1px #B388FF;  /* Grosor y color del borde */
    border-radius: 5px;         /* Bordes redondeados */
}

tooltip {
    background-color: #0D031B;
    border-radius: 5px;
    color: #B388FF;
    border: 0;
}

window#waybar {
    background: transparent;
    border-radius: 30px;
    padding-top: 2px;
    color:#B388FF;
	  
}

tooltip label {
  color: #B388FF;
}

.modules-left {
    background: transparent;
    margin: 0px 0px;
    border-radius: 60px;
}

.modules-center {
    background: @bg;
    margin: 10px 0px;
    border-radius: 30px;
}

.modules-right {
    background: @bg;
    margin: 10px 0px;
    border-radius: 30px;
}

#workspaces {
    padding: 5px 10px;
    background: @bg;
    margin: 10px 10px;
    border-radius: 30px;
}

#workspaces button {
    padding: 0px 2px;
    background: transparent;
    font-size: 16px;
    color: transparent;
    border-radius: 15px;
    transition: all 150ms ease-in-out;
}

#workspaces button.active {
    min-width: 10px;
    background: transparent;
    color: @bg;
    border-radius: 15px;
    border: 1px solid #B388FF; 
    border-radius: 15px;        
    padding: 2px 6px;    
}

#clock {
    padding: 0px 10px;
    color: #B388FF;
    background: transparent;
    border-radius: 30px;
    margin: 7px 5px;
    transition: all 150ms ease-in-out;
}

#battery {
    padding: 0px 10px;
	color: #B388FF;
    background: transparent;
    border-radius: 30px;
    margin: 7px 5px;
}

#pulseaudio {
    padding: 0px 10px;
    background: transparent;
    border-radius: 30px;
    margin: 7px 5px;
    font-size: 18px;
}

#custom-power {
    font-size: 16px;
    padding: 0px 11px;
    background: transparent;
    border-radius: 30px;
    margin: 7px 5px;
}

#backlight {
    padding: 0px 11px;
    background: transparent;
    border-radius: 30px;
    margin: 7px 5px;
    font-size: 16px;
}

#network {
    padding: 0 10px;
    background: transparent;
    border-radius: 30px;
    margin: 7px 5px;
}

#mpris {
    font-size: 14px;
    padding: 0px 12px;
    background: @bg;
    color: #B988FF;
    border-radius: 20px;
    margin: 10px 5px;
}

#mpris.playing {
    color: #B988FF;
}

#mpris.paused {
    color: #805bb5;
}

#mpris {
    padding: 0 10px;
    font-weight: bold;
}
